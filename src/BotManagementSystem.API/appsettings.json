{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "ApplicationInsights": {
    "ConnectionString": "YOUR_APPLICATION_INSIGHTS_CONNECTION_STRING"
  },
  "Jwt": {
    "Key": "YOUR_JWT_SECRET_KEY_HERE_AT_LEAST_32_CHARACTERS_LONG",
    "Issuer": "BotManagementSystem",
    "Audience": "BotManagementSystem.API",
    "ExpiryInMinutes": 1440
  },
  "OpenAI": {
    "ApiKey": "",
    "ModelId": "gpt-3.5-turbo",
    "PromptExecutionSettings": {
      "MaxTokens": 2000,
      "Temperature": 0.7,
      "TopP": 0.8
    }
  },
  "AIShell": {
    "ApiKey": "${OpenAI:ApiKey}",
    "DefaultModel": "gpt-3.5-turbo",
    "EnableCaching": true,
    "CacheDuration": "01:00:00"
  }
}
